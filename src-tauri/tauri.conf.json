{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "CopyCat",
  "version": "0.1.0",
  "identifier": "com.krisgreenwald.copycat",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../build"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "CopyCat HUD",
        "width": 320,
        "height": 400,
        "resizable": false,
        "decorations": false,
        "transparent": true,
        "alwaysOnTop": true,
        "visible": false,
        "skipTaskbar": true,
        "url": "/"
      }
    ],
    "security": {
      "csp": null
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEFEMUZFMkVBQUY5Nzc0QTcKUldTbmRKZXY2dUlmclkwb1FjbjY1aXJKUUkxUklyZ3ByZFNWc2JhcjdXb2JMVWY4cWJTSUdNRzUK",
      "endpoints": [
        "https://github.com/kristigordon/copycat/releases/latest/download/latest.json"
      ]
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  }
}
